{
  "manifest_version": 3,
  "name": "Tab Audio Recorder",
  "version": "0.1.0",
  "description": "Graba fragmentos cortos de audio de una pestaña con fines educativos y de investigación personal.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Audio Recorder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["tabCapture", "offscreen", "downloads", "activeTab", "storage"]
}
